{
  "name": "sancarlina-firestore-rules-tests",
  "private": true,
  "scripts": {
    "compare:rules": "node scripts/compare-firestore-rules.js",
    "test:rules": "firebase emulators:exec --only firestore,storage \"npm run test:rules:only\"",
    "test:rules:only": "jest rules-tests --runInBand",
    "test:rules:firestore": "firebase emulators:exec --only firestore \"jest rules-tests/firestore.rules.test.js --runInBand\"",
    "test:rules:storage": "firebase emulators:exec --only storage \"jest rules-tests/storage.rules.test.js --runInBand\"",
    "preview:stitch": "npx --yes http-server docs/stitch -p 8765 -c-1 --cors"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^15.18.0",
    "jest": "^29.7.0"
  }
}
