// GondolApp / Sancarlina — Firebase Storage
// Adjuntos offline-first: cada usuario solo escribe dentro de su propia ruta.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{userId}/{submissionId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.get('role', '') == 'admin');
      allow write: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.get('role', '') == 'admin')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Evita que la lectura pública general se superponga con submissions.
    match /{topLevel}/{allPaths=**} {
      allow read: if topLevel != 'submissions';
      allow write: if topLevel != 'submissions'
        && request.auth != null
        && request.auth.token.get('role', '') == 'admin';
    }
  }
}
