// DRAFT — NO DEPLOY
// GondolApp / Sancarlina — storage.rules borrador local (Fase 2B-3.1)
// App Android no usa Firebase Storage hoy; reglas orientadas a web admin.
// Validar en Firebase Rules Simulator antes de deploy (Fase 2B-3.2).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
