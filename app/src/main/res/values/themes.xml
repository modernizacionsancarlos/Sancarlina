    <style name="Theme.Sancarlina" parent="android:Theme.Material.Light.NoActionBar" />
    
    <!-- Tema para la pantalla de carga nativa del sistema Android -->
    <style name="Theme.Sancarlina.Launcher" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowActivityTransitions">true</item>
