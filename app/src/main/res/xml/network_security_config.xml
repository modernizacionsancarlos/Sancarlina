<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red (producción).

    El tráfico en texto plano queda prohibido en toda la aplicación: Firebase,
    Google Maps y Firebase Storage operan siempre sobre HTTPS. Si una imagen de
    catálogo se cargara por HTTP, Coil fallará de forma visible en lugar de
    enviar la petición sin cifrar; la corrección correcta es publicar ese recurso
    por HTTPS desde el panel de administración.

    La variante debug sobrescribe este archivo para permitir los emuladores
    locales de Firebase (ver app/src/debug/res/xml/network_security_config.xml).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
