<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de extracción de datos (Android 12+): cloud backup y transferencia entre dispositivos.
   Excluye preferencias locales sensibles (cifradas y legacy).
   Ver: https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_sancarlina_prefs.xml" />
        <exclude domain="sharedpref" path="sancarlina_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_sancarlina_prefs.xml" />
        <exclude domain="sharedpref" path="sancarlina_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
