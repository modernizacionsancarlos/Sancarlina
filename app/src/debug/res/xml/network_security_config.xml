<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red (solo desarrollo).

    Mantiene la prohibición general de texto plano y habilita únicamente los
    destinos de los emuladores de Firebase: 10.0.2.2 es el host de la máquina de
    desarrollo visto desde el emulador de Android.

    Este archivo no se incluye en los builds de release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
