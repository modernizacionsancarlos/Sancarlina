{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stitch Preview (Mobile Preview)",
      "type": "npm",
      "script": "preview:stitch",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": {
        "owner": "stitch-preview",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Available on:"
        }
      }
    }
  ]
}
